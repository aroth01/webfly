{
  "name": "webfly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "navdata:build": "tsx navdata/build.ts",
    "decode": "tsx scripts/decode.ts",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning server/main.ts --seed",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "dev:web": "vite --config web/vite.config.ts --host",
    "build:web": "vite build --config web/vite.config.ts",
    "test:visual": "playwright test -c web/playwright.config.ts",
    "swim:replay": "tsx --disable-warning=ExperimentalWarning scripts/swim-replay.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "solclientjs": "^10.18.3"
  },
  "devDependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "geomagnetism": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
