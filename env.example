# Copy to .env (git-ignored). Loaded automatically by `npm run dev:server` / `npm start`.

# FlightAware AeroAPI key, the source of filed routes. Without it only seeded plans and expected routes work.
# The Personal tier is licensed for personal, non-public use and is tightly rate limited.
AEROAPI_KEY=

# Locks /api/* behind a login: people enter this code once and get a session cookie.
# Required when NODE_ENV=production (set ALLOW_PUBLIC=1 to run open instead).
ACCESS_CODE=
# Optional. Signs session cookies; set it so logins survive server restarts (any long random string).
SESSION_SECRET=
